# Proyecto y región de Google Cloud
GOOGLE_CLOUD_PROJECT=mi-proyecto-gcp
GOOGLE_CLOUD_LOCATION=us-central1

# Usar Vertex AI (TRUE) o Gemini API con API key (FALSE)
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Modelo de Gemini usado por el agente
MODEL=gemini-2.5-flash

# Colección de Firestore con las pólizas. Usar "memory" para datos de ejemplo locales.
FIRESTORE_COLLECTION=polizas
REPOSITORY_BACKEND=memory

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
